# Copy to .env.local (git-ignored) and fill in. All values are public: they end
# up in the browser bundle, so never put secrets here.

# Backend origin (no trailing slash, no /api/v1) used by `pnpm dev`/`pnpm preview`:
# the app calls /api/v1/... on its own origin and Vite proxies /api to this URL.
# Also the default source of `pnpm api:sync`. Local backend: http://localhost:8000
# Deployed: https://tuttitrip-api-develop.gburek.app (develop), https://tuttitrip-api.gburek.app (main)
VITE_API_URL=http://localhost:8000

# Auth0 SPA application (the backend team owns the tenant). Leave empty to run
# without login: the app shows a "login disabled" message instead.
# Values used by the deployed apps (SPA "TuttiTrip Web"):
#   VITE_AUTH0_DOMAIN=dev-yahwm2zlut2gqdry.us.auth0.com
#   VITE_AUTH0_CLIENT_ID=Q18lEcCNyP3Xut5wnuHYrGsoVf1pbKdl
#   VITE_AUTH0_AUDIENCE=https://tuttitrip-api.gburek.app
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# API identifier (token audience)
VITE_AUTH0_AUDIENCE=
