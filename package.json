{
  "name": "tuttitrip-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-arch.mjs",
    "verify": "biome ci . && tsc -b && pnpm test:arch",
    "api:sync": "node scripts/api-sync.mjs",
    "pwa:icons": "pwa-assets-generator",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.1",
    "@hookform/resolvers": "^5.9.1",
    "@keyline-icons/react": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.5.0",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  }
}
