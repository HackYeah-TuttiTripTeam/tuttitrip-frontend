{
  "name": "tuttitrip-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_API_MOCK=1 vite",
    "build": "pnpm i18n && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm i18n && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-arch.mjs",
    "verify": "pnpm i18n && biome ci . && tsc -b && pnpm test:arch && pnpm test",
    "api:sync": "node scripts/api-sync.mjs",
    "deploy": "wrangler deploy",
    "i18n": "node scripts/i18n.mjs",
    "postinstall": "pnpm i18n",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:local": "pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@auth0/auth0-react": "^2.28.1",
    "@hookform/resolvers": "^5.9.1",
    "@keyline-icons/react": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^9.2.4",
    "@vis.gl/react-google-maps": "1.10.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "eventsource-parser": "^4.1.1",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.5.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  }
}
