// Cloudflare Workers deployment: the SPA as static assets plus a small Worker
// script (worker/index.ts) that proxies /api/* to the backend of the environment.
// One Worker per environment; see AGENTS.md "Deployment" and .github/workflows/frontend-ci.yml.
//   main            -> worker tuttitrip-frontend          -> https://tuttitrip.gburek.app
//   develop         -> worker tuttitrip-frontend-develop  -> https://tuttitrip-develop.gburek.app
//   pull request    -> worker tuttitrip-preview-<slug>    -> https://tuttitrip-preview-<slug>.gburek.app
//                      (deployed with --env preview --name ... --var API_ORIGIN:<backend>,
//                      domain attached by scripts/attach-domain.mjs, both deleted when
//                      the branch is gone)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tuttitrip-frontend",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep links (/trips?sort=name) get index.html; the router takes it from there.
    "not_found_handling": "single-page-application",
    // /api/* never hits the assets or the SPA fallback: the Worker proxies it.
    // /assets/* goes through it too: the assets layer answers a missing GET there with the
    // SPA fallback itself (200 index.html, Worker not invoked, verified on a preview), so only
    // the Worker can turn a chunk removed by a newer deploy into a 404 (worker/index.ts).
    // The manifest goes through it to get the user's language (worker/index.ts).
    // The public pages and the crawler files go through it for their per-page metadata and
    // first screen. /glos (voting link) is on it only to get Referrer-Policy: no-referrer. /demo (the jury's link,
    // token in the fragment) stays off this list on purpose:
    // it is the SPA fallback like any other app route, with no Worker code in its path.
    // Every other navigation is the assets layer's SPA fallback, no script.
    "run_worker_first": [
      "/api/*",
      "/assets/*",
      "/manifest.webmanifest",
      "/",
      "/about",
      "/about/",
      "/contact",
      "/contact/",
      "/prywatnosc",
      "/prywatnosc/",
      "/glos",
      "/glos/",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tuttitrip.gburek.app", "custom_domain": true }],
  // Backend origin for the /api proxy; ENVIRONMENT is "production" only here, and decides whether
  // search engines may index the site (worker/index.ts). Vars are not inherited by environments.
  "vars": { "API_ORIGIN": "https://tuttitrip-api.gburek.app", "ENVIRONMENT": "production" },
  "env": {
    "develop": {
      "name": "tuttitrip-frontend-develop",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "tuttitrip-develop.gburek.app", "custom_domain": true }],
      "vars": { "API_ORIGIN": "https://tuttitrip-api-develop.gburek.app", "ENVIRONMENT": "develop" }
    },
    "preview": {
      // CI overrides the name per branch: --name tuttitrip-preview-<slug>.
      // No workers.dev: that subdomain sits behind Cloudflare Access on this account.
      "name": "tuttitrip-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      // CI passes the backend picked by scripts/resolve-api.sh: --var API_ORIGIN:<url>.
      "vars": { "API_ORIGIN": "https://tuttitrip-api-develop.gburek.app", "ENVIRONMENT": "preview" }
    }
  }
}
